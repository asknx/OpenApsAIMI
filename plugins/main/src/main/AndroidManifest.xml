<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <activity
            android:name=".general.smsCommunicator.activities.SmsCommunicatorOtpActivity"
            android:exported="false"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="app.aaps.plugins.main.general.smsCommunicator.activities.SmsCommunicatorOtpActivity" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".general.dashboard.DashboardModesActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".general.dashboard.AdjustmentDetailsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".general.manual.UserManualActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".general.dashboard.LoopStateActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <service 
            android:name=".general.persistentNotification.DummyService"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>